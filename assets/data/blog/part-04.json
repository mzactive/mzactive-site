eRanges":[],"entityRanges":[],"data":{}},{"key":"6q5ot","text":"- **التركيز**: التدريب على الظروف الفعلية للمنافسة، تحسين السرعة والفعالية، تقليل حجم التدريبات مع التركيز على الجودة.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"b5lja","text":"- **المدة**: تكون هذه المرحلة أقصر نسبياً وغالباً ما تمتد لبضعة أسابيع قبل المنافسة.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"53tp5","text":"4. **مرحلة ما بعد المنافسة**:","type":"header-four","depth":0,"inlineStyleRanges":[{"offset":3,"length":26,"style":"BOLD"},{"offset":3,"length":26,"style":"UNDERLINE"}],"entityRanges":[],"data":{}},{"key":"aiqb8","text":"- **الهدف**:","type":"unstyled","depth":0,"inlineStyleRanges":[{"offset":2,"length":10,"style":"UNDERLINE"}],"entityRanges":[],"data":{}},{"key":"8csmo","text":" استعادة العضلات والجسم بعد فترة المنافسة وتقييم الأداء.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"9p3tc","text":"- **التركيز**: تدريبات خفيفة وإعادة التأهيل، الراحة النشطة، وتقييم الأداء والتخطيط للمراحل القادمة.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"d37vq","text":"- **المدة**: تتراوح بين بضعة أيام إلى أسابيع، حسب شدة المنافسة واحتياجات الجسم للاستشفاء.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"bihbh","text":"هذه المراحل الأربعة تساهم في ضمان تطور مستدام وأداء عالي للرياضيين والمتدربين في مختلف الرياضات والنشاطات البدنية.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":{"0":{"type":"IMAGE","mutability":"IMMUTABLE","data":{"src":"assets/images/blog/add89ec454e642a54169.jpg","loading":false,"left":"0.99%","top":"0.99%","width":"98.01%","height":"98.01%","rotation":"0","editedAspectRatio":"1.2414698162729658","filter":"NONE"}}},"language":"ar"}]